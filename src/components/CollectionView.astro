---
// Shared shell for /collections/ and /collections/<category>:
// lightweight breadcrumb, title, optional description, single-tier pill switcher, masonry.
import PillNav, { type Subcategory } from './PillNav.astro';
import PhotoMasonry from './PhotoMasonry.astro';

export interface Props {
  title: string;
  description?: string | null;
  active: string;
  categories: Array<{ key: string; name: string }>;
  subcategories?: Subcategory[];
  groups: Array<{ label: string | null; photos: Record<string, unknown>[] }>;
  emptyMessage?: string;
}
const { title, description, active, categories, subcategories = [], groups, emptyMessage } = Astro.props;
const isAll = active === 'all';
---

<section class="collection" data-collection-view>
  <header class="collection-head">
    {
      !isAll && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/collections/" class="breadcrumb-link">Gallery</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <a href={`/collections/${active}/`} class="breadcrumb-link breadcrumb-current" data-breadcrumb-cat>{title}</a>
          <span data-breadcrumb-sub-wrap style="display: none;">
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <span class="breadcrumb-current" data-breadcrumb-sub></span>
          </span>
        </nav>
      )
    }
    <h1 class="collection-title">{title}</h1>
    {
      description && (
        <p class="collection-desc">{description}</p>
      )
    }
  </header>

  <PillNav categories={categories} active={active} subcategories={subcategories} />

  {
    groups.length === 0 ? (
      <p class="collection-empty">
        {emptyMessage ?? 'No photographs yet — drop images into src/photos/ and rebuild.'}
      </p>
    ) : (
      <PhotoMasonry groups={groups} />
    )
  }
</section>

<script>
  function setupSubcatFilter() {
    const nav = document.querySelector('[data-subcat-nav]');
    if (!nav) return;

    const pills = Array.from(nav.querySelectorAll<HTMLButtonElement>('[data-subcat-filter]'));
    const frames = Array.from(document.querySelectorAll<HTMLElement>('.ph-frame[data-subcat]'));
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-subcat-block]'));

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const target = pill.dataset.subcatFilter;
        if (!target) return;

        pills.forEach((p) => p.classList.toggle('is-active', p === pill));

        const subWrap = document.querySelector<HTMLElement>('[data-breadcrumb-sub-wrap]');
        const subText = document.querySelector<HTMLElement>('[data-breadcrumb-sub]');
        const catLink = document.querySelector<HTMLElement>('[data-breadcrumb-cat]');
        if (subWrap && subText) {
          if (target === 'all') {
            subWrap.style.display = 'none';
            catLink?.classList.add('breadcrumb-current');
          } else {
            subWrap.style.display = 'inline';
            subText.textContent = pill.textContent?.trim() || '';
            catLink?.classList.remove('breadcrumb-current');
          }
        }

        if (frames.length > 0) {
          frames.forEach((frame) => {
            const sub = frame.dataset.subcat;
            if (target === 'all' || sub === target) {
              frame.style.display = '';
            } else {
              frame.style.display = 'none';
            }
          });
        }

        if (blocks.length > 0) {
          blocks.forEach((block) => {
            const blockSlug = block.dataset.subcatBlock;
            if (!blockSlug || target === 'all' || blockSlug === target) {
              block.style.display = '';
            } else {
              block.style.display = 'none';
            }
          });
        }
      });
    });
  }

  setupSubcatFilter();
  document.addEventListener('astro:page-load', setupSubcatFilter);
</script>
