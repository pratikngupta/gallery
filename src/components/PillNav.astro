---
// Collection switcher: All + one link per category. The active pill is the
// category the visitor is on (or "all").
export interface Props {
  categories: Array<{ key: string; name: string }>;
  active: string; // 'all' or a category key
}
const { categories, active } = Astro.props;
---

<nav class="pill-nav" aria-label="Collections">
  <a class="pill" href="/collections/" class:list={{ 'is-active': active === 'all' }}>All</a>
  {
    categories.map((c) => (
      <a
        class="pill"
        href={`/collections/${c.key}`}
        class:list={{ 'is-active': active === c.key }}
      >
        {c.name}
      </a>
    ))
  }
</nav>
