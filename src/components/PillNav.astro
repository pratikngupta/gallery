---
// Collection switcher: All + one link per category.
// When subcategories exist for the active category, renders a secondary subcategory row.
export interface Subcategory {
  key: string;
  name: string;
  count?: number;
}

export interface Props {
  categories: Array<{ key: string; name: string }>;
  active: string; // 'all' or a category key
  subcategories?: Subcategory[];
}

const { categories, active, subcategories = [] } = Astro.props;
const activeCategoryName = categories.find((c) => c.key === active)?.name || 'Works';
const slug = (str: string) => str.toLowerCase().replace(/[^a-z0-9]/g, '-');
---

<nav class="pill-nav-container" aria-label="Collections and Subcategories">
  <!-- Primary: Category Switcher -->
  <div class="pill-nav" aria-label="Categories">
    <a class="pill" href="/collections/" class:list={{ 'is-active': active === 'all' }}>All</a>
    {
      categories.map((c) => (
        <a
          class="pill"
          href={`/collections/${c.key}`}
          class:list={{ 'is-active': active === c.key }}
        >
          {c.name}
        </a>
      ))
    }
  </div>

  <!-- Secondary: Subcategory Switcher -->
  {
    subcategories.length > 0 && (
      <div class="subcat-nav" data-subcat-nav aria-label="Subcategories">
        <button class="subcat-pill is-active" data-subcat-filter="all" type="button">
          All {activeCategoryName}
        </button>
        {
          subcategories.map((s) => (
            <button
              class="subcat-pill"
              data-subcat-filter={slug(s.name)}
              type="button"
            >
              {s.name}
              {s.count ? <span class="subcat-pill-count">{s.count}</span> : null}
            </button>
          ))
        }
      </div>
    )
  }
</nav>
