---
// Collection switcher:
// - On '/collections/' (active === 'all'): renders primary category pills [All, Aircraft, ...]
// - On dedicated category pages (active !== 'all'): renders only the category's sub-filters [All Aircraft, F-16, ...]
export interface Subcategory {
  key: string;
  name: string;
  count?: number;
}

export interface Props {
  categories: Array<{ key: string; name: string }>;
  active: string; // 'all' or a category key
  subcategories?: Subcategory[];
}

const { categories, active, subcategories = [] } = Astro.props;
const isAll = active === 'all';
const activeCategoryName = categories.find((c) => c.key === active)?.name || 'Works';
const slug = (str: string) => str.toLowerCase().replace(/[^a-z0-9]/g, '-');
---

{
  isAll ? (
    <nav class="pill-nav" aria-label="Categories">
      <a class="pill is-active" href="/collections/">All</a>
      {
        categories.map((c) => (
          <a class="pill" href={`/collections/${c.key}`}>
            {c.name}
          </a>
        ))
      }
    </nav>
  ) : (
    subcategories.length > 0 && (
      <nav class="subcat-nav" data-subcat-nav aria-label={`${activeCategoryName} sub-categories`}>
        <button class="subcat-pill is-active" data-subcat-filter="all" type="button">
          All {activeCategoryName}
        </button>
        {
          subcategories.map((s) => (
            <button
              class="subcat-pill"
              data-subcat-filter={slug(s.name)}
              type="button"
            >
              {s.name}
            </button>
          ))
        }
      </nav>
    )
  )
}
