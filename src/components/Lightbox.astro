---
// The viewer. Always the darkroom, in both themes. Deep links look like
// #photo/<id> and are handled by the script below.
export interface Props {
  manifest: Array<{ id: string; title: string; full: string; exif: string[] }>;
}
const { manifest } = Astro.props;
---

<div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Photograph viewer" hidden>
  <div class="lb-top">
    <h2 class="lb-title" data-lb-title></h2>
    <span class="lb-count" data-lb-count></span>
    <button class="lb-btn lb-close" data-lb-close aria-label="Close viewer">✕</button>
  </div>
  <div class="lb-stage">
    <button class="lb-btn lb-prev" data-lb-prev aria-label="Previous photograph">←</button>
    <img class="lb-img" data-lb-img src="data:," alt="" />
    <button class="lb-btn lb-next" data-lb-next aria-label="Next photograph">→</button>
  </div>
  <p class="lb-exif" data-lb-exif></p>
</div>

<script>
  const manifest = Astro.props.manifest;

  const lb = document.querySelector('[data-lightbox]');
  if (lb && manifest.length) {
    const img = lb.querySelector('[data-lb-img]');
    const titleEl = lb.querySelector('[data-lb-title]');
    const countEl = lb.querySelector('[data-lb-count]');
    const exifEl = lb.querySelector('[data-lb-exif]');
    const closeBtn = lb.querySelector('[data-lb-close]');
    const prevBtn = lb.querySelector('[data-lb-prev]');
    const nextBtn = lb.querySelector('[data-lb-next]');
    let idx = -1;
    let lastFocus = null;

    const open = (i, push = true) => {
      idx = i;
      render();
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      lastFocus = document.activeElement;
      closeBtn.focus({ preventScroll: true });
      if (push) history.pushState(null, '', '#photo/' + manifest[i].id);
    };

    const close = () => {
      lb.hidden = true;
      document.body.style.overflow = '';
      idx = -1;
      img.removeAttribute('src');
      if (location.hash.startsWith('#photo/')) {
        history.replaceState(null, '', location.pathname + location.search);
      }
      lastFocus?.focus?.({ preventScroll: true });
    };

    const step = (d) => open((idx + d + manifest.length) % manifest.length);

    const render = () => {
      const p = manifest[idx];
      img.src = p.full;
      img.alt = p.title;
      titleEl.textContent = p.title;
      countEl.textContent = `${idx + 1} / ${manifest.length}`;
      exifEl.textContent = p.exif.join('  ·  ');
      // warm the neighbors so arrow-key travel feels instant
      [idx + 1, idx - 1].forEach((j) => {
        const q = manifest[(j + manifest.length) % manifest.length];
        const pre = new Image();
        pre.src = q.full;
      });
    };

    document.querySelectorAll('[data-open]').forEach((el) =>
      el.addEventListener('click', () => {
        const i = manifest.findIndex((p) => p.id === el.dataset.open);
        if (i > -1) open(i);
      })
    );

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') step(1);
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'Tab') {
        // focus stays inside the viewer
        const focusables = [closeBtn, prevBtn, nextBtn];
        const i = focusables.indexOf(document.activeElement);
        e.preventDefault();
        const next = e.shiftKey
          ? i <= 0
            ? focusables.length - 1
            : i - 1
          : i === -1 || i === focusables.length - 1
            ? 0
            : i + 1;
        focusables[next].focus();
      }
    });

    let touchX = null;
    lb.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
    lb.addEventListener(
      'touchend',
      (e) => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 48) step(dx < 0 ? 1 : -1);
        touchX = null;
      },
      { passive: true }
    );

    const fromHash = () => {
      const m = location.hash.match(/^#photo\/(.+)$/);
      return m ? manifest.findIndex((p) => p.id === decodeURIComponent(m[1])) : -1;
    };

    window.addEventListener('popstate', () => {
      const i = fromHash();
      if (i > -1) {
        idx = i;
        render();
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
      } else if (!lb.hidden) close();
    });

    // deep link straight to a photo
    const start = fromHash();
    if (start > -1) open(start, false);
  }
</script>
