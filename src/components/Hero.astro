---
// Full-bleed opening photograph with the name set in the center on a scrim —
// the name, a line about the work, and an invitation to the gallery.
// If the library is empty, a quiet dark hero carries the name alone.
export interface Props {
  image?: { src: string; srcset?: string; alt: string };
}
const { image } = Astro.props;
---

<section class="hero" id="top">
  {
    image && (
      <>
        <img
          src={image.src}
          {...(image.srcset ? { srcset: image.srcset, sizes: '100vw' } : {})}
          alt={image.alt}
          fetchpriority="high"
        />
        <div class="hero-scrim" aria-hidden="true"></div>
      </>
    )
  }
  <div class="hero-center">
    <h1 class="hero-name">Pratik Gupta</h1>
    <p class="hero-sub">Photographs of aircraft, wildlife, nature and cities</p>
    <a class="hero-cta" href="/collections/">View the gallery</a>
  </div>
</section>
