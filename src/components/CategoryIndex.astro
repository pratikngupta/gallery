---
// The table of contents. Hovering a row develops that category's cover into
// the section background (JS in Layout.astro). Scrollspy marks the row whose
// section is in view.
export interface Props {
  categories: Array<{ key: string; name: string; count: number; coverUrl?: string }>;
}
const { categories } = Astro.props;
---

<section class="index" id="index" aria-label="Categories">
  <img class="index-bg" data-index-bg src="data:," alt="" aria-hidden="true" />
  <div class="index-veil" aria-hidden="true"></div>
  <ol class="index-list">
    {
      categories.map((c, i) => (
        <li>
          <a
            class="index-row"
            href={`/collections/${c.key}`}
            data-row={c.key}
            data-cover={c.coverUrl ?? ''}
          >
            <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="index-name">{c.name}</span>
            <span class="index-count">
              {c.count} {c.count === 1 ? 'photograph' : 'photographs'}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
