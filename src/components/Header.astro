---
import AppearanceControls from './AppearanceControls.astro';
// Fixed site header: PRATIK GUPTA wordmark + appearance controls — one row
// on every screen (owner: the two-row phone header was dropped).
// Desktop: the inline nav (HOME / GALLERY / ABOUT) and the appearance
// controls (palette dots + theme toggle) sit in the row. There is no
// hamburger: a menu that only held the appearance controls was a false
// promise, so those controls are the row's own.
// Mobile: the row has no room for the links, so the MENU popover holds them
// plus the appearance controls (progressive disclosure, same component).
// The trigger toggles the popover via popovertarget — Esc and focus return
// are browser-native.
const nav = [
  { href: '/', label: 'HOME' },
  { href: '/collections/', label: 'GALLERY' },
  { href: '/about/', label: 'ABOUT' },
];
const here = Astro.url.pathname.replace(/index\.html$/, '');
const isCurrent = (href) =>
  href === '/' ? here === '/' : here === href || here.startsWith(href);
---

<header class="site-header" data-header transition:name="header" transition:animate="none">
  <div class="site-header-inner">
    <a class="wordmark" href="/" aria-label="Pratik Gupta Photography">PRATIK GUPTA</a>
    <nav class="site-nav" aria-label="Main">
      {
        nav.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
      {n.label}
      </a>
    ))
  }
  </nav>
    <AppearanceControls />
    <button
      type="button"
      class="menu-trigger"
      id="menu-trigger"
      popovertarget="site-menu"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      MENU
    </button>
  </div>
  <dialog class="site-menu" id="site-menu" popover>
    <nav class="menu-nav" aria-label="Main">
      {
        nav.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <AppearanceControls inMenu />
  </dialog>
</header>
