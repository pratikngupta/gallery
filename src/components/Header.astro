---
// Fixed site header with PRATIK GUPTA wordmark, centered navigation, and theme toggle.
// The header holds still across navigations (the footer already does the same), so
// only its content changes — one fewer fade per navigation.
const nav = [
  { href: '/', label: 'HOME' },
  { href: '/collections/', label: 'GALLERY' },
  { href: '/about/', label: 'ABOUT' },
];
const here = Astro.url.pathname.replace(/index\.html$/, '');
const isCurrent = (href) =>
  href === '/' ? here === '/' : here === href || here.startsWith(href);
---

<header class="site-header" data-header>
  <div class="site-header-inner">
    <a class="wordmark" href="/" aria-label="Pratik Gupta Photography">PRATIK GUPTA</a>
    <nav class="site-nav" aria-label="Main">
      {
        nav.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme" title="Switch theme">
        <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
