---
// Masonry blocks: an optional label, then a CSS-columns masonry of prints.
// Each print links to its detail page (/photo/<id>) and carries a
// transition:name so Astro View Transitions can morph the tile into the
// detail page's image.
export interface Props {
  groups: Array<{ label: string | null; photos: Record<string, unknown>[] }>;
}
const { groups } = Astro.props;
---

{
  groups.map((g) => (
    <div class="masonry-block">
      {g.label && <h3 class="subcat-label">{g.label}</h3>}
      <div class="masonry">
        {
          g.photos.map((p) => (
            <figure class="ph-item">
              <a
                class="ph-frame"
                href={`/photo/${p.id}`}
                transition:name={`image-${p.id}`}
                aria-label={`View ${p.title}`}
              >
                <img
                  class="ph-img"
                  src={p.thumb}
                  loading="lazy"
                  alt={p.title}
                  data-full={p.gridSrc}
                />
              </a>
              <figcaption class="ph-cap">
                <span class="ph-title">{p.title}</span>
                <span class="ph-year">{p.year}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  ))
}
