---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const {
  title,
  description = 'Photographs by Pratik Gupta — aircraft, birds, animals, nature, buildings and field notes.',
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- Resolve the theme before first paint to avoid a flash, and reapply on Astro view transition swaps -->
    <script is:inline>
      function applyStoredTheme() {
        try {
          var t = localStorage.getItem('darkroom-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      }
      applyStoredTheme();
      document.addEventListener('astro:after-swap', applyStoredTheme);
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- View Transitions are on by default in Astro 7; ClientRouter gives
         SPA-style navigation, and transition:name attributes (tiles, detail
         image, footer) mark the shared elements. -->
    <ClientRouter />
  </head>
  <body transition:animate="initial">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <noscript>
      <style>.ph-img { filter: none !important; transform: none !important; }</style>
    </noscript>

    <script>
      // ——— theme toggle ———
      function getTheme() {
        return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      }

      function setTheme(next) {
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('darkroom-theme', next);
        } catch (e) {}
        updateThemeButtons(next);
      }

      function updateThemeButtons(theme) {
        const label = theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
        document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
          btn.setAttribute('aria-label', label);
          btn.setAttribute('title', label);
        });
      }

      // Delegate on document so it works reliably across all Astro View Transitions
      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const toggle = target.closest('[data-theme-toggle]');
        if (!toggle) return;
        e.preventDefault();
        const current = getTheme();
        const next = current === 'dark' ? 'light' : 'dark';
        setTheme(next);
      });

      document.addEventListener('astro:page-load', () => {
        updateThemeButtons(getTheme());
      });

      // ——— header background after the hero ———
      const header = document.querySelector('[data-header]');
      if (header) {
        addEventListener('scroll', () => {
          header.classList.toggle('is-scrolled', scrollY > 24);
        }, { passive: true });
      }

      // ——— blur-up: swap the 40px thumbnail for the full grid image ———
      // Listened on `document` (capture) so it survives View Transition
      // navigations, plus a sweep for images that finished loading before
      // this script ran (cached 40px thumbs on a fast local server).
      const upgrade = (img) => {
        const full = img.dataset.full;
        if (full && !img.dataset.upgraded) {
          img.dataset.upgraded = '1';
          img.src = full;
        } else {
          img.classList.add('is-loaded');
        }
      };
      document.addEventListener(
        'load',
        (e) => {
          const t = e.target;
          if (t instanceof HTMLImageElement && t.classList.contains('ph-img')) upgrade(t);
        },
        true
      );
      const sweep = () =>
        document
          .querySelectorAll('.ph-img')
          .forEach((img) => {
            if (img.complete && img.naturalWidth > 0 && !img.dataset.upgraded) upgrade(img);
          });
      sweep();
    </script>
  </body>
</html>
