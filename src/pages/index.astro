---
import Layout from '../layouts/Layout.astro';
import { scanPhotos } from '../lib/photos.mjs';
import { withUrls, featuredFor, heroSlidesFor } from '../lib/render.mjs';
import Hero from '../components/Hero.astro';
import PhotoMasonry from '../components/PhotoMasonry.astro';

// Home: Editorial hero with switching photo showcase, followed by the featured wall.
const { categories, photos, empty } = await scanPhotos();

const heroSlides = heroSlidesFor(photos);
const activeHeroId = heroSlides[0]?.id;
const featured = featuredFor(photos, categories, 9, activeHeroId);
const featuredUrls = featured.map(withUrls);
const byId = new Map(featuredUrls.map((p) => [p.id, p]));

const categoriesWithUrls = categories.map((c) => ({
  ...c,
  coverUrl: c.cover ? withUrls(c.cover) : null,
}));
---

<Layout title="Pratik Gupta — Photographs">
  <Hero slides={heroSlides} />

  <section class="featured" id="featured">
    {
      empty ? (
        <p class="featured-empty">
          No photographs yet. Drop images into
          <code class="mono">src/photos/&#123;category&#125;/</code> and rebuild — the featured
          wall and every collection page build themselves from the folders.
        </p>
      ) : (
        <>
          <div class="featured-head">
            <h2 class="featured-title">Featured works</h2>
            <p class="featured-sub">A selection of my best photographs from the collections</p>
          </div>
          <PhotoMasonry groups={[{ label: null, photos: featuredUrls.map((p) => byId.get(p.id)) }]} />
        </>
      )
    }
  </section>

  {
    !empty && (
      <section class="gallery-portal" id="full-gallery">
        <header class="gallery-portal-head">
          <p class="hero-eyebrow">THE ARCHIVE</p>
          <h2 class="gallery-portal-title">Explore the full gallery</h2>
          <p class="gallery-portal-sub">
            {photos.length} photographs across {categories.length} curated collections
          </p>
        </header>

        <div class="gallery-portal-grid">
          {categoriesWithUrls.map((cat) => (
            <a href={`/collections/${cat.key}/`} class="gallery-cat-card" aria-label={`View ${cat.name} collection`}>
              <div class="gallery-cat-thumb">
                {cat.coverUrl && (
                  <img
                    src={cat.coverUrl.thumb}
                    data-full={cat.coverUrl.gridSrc}
                    alt={cat.name}
                    class="ph-img"
                    loading="lazy"
                  />
                )}
              </div>
              <div class="gallery-cat-info">
                <span class="gallery-cat-name">{cat.name}</span>
                <span class="gallery-cat-count mono">
                  {cat.count} {cat.count === 1 ? 'photograph' : 'photographs'}
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="gallery-portal-action">
          <a href="/collections/" class="gallery-cta-pill">
            <span>Browse Complete Archive</span>
            <span class="gallery-cta-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }
</Layout>
