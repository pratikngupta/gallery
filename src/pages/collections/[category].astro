---
import Layout from '../../layouts/Layout.astro';
import CollectionView from '../../components/CollectionView.astro';
import { scanPhotos } from '../../lib/photos.mjs';
import { withUrls } from '../../lib/render.mjs';

// /collections/<category> — one series at a time, so no page is ever longer
// than one body of work.
export const getStaticPaths = async () => {
  const { categories } = await scanPhotos();
  return categories.map((c) => ({
    params: { category: c.key },
    props: { categoryKey: c.key },
  }));
};

const { categoryKey } = Astro.props;
const { categories, photos } = await scanPhotos();
const cat = categories.find((c) => c.key === categoryKey) ?? categories[0];
// One wall per collection: the chips filter what is on the page rather than
// the page being cut into sections.
const wall = cat.photos.map(withUrls);
---

<Layout title={`${cat.name} — Pratik Gupta`} description={cat.description ?? undefined}>
  <CollectionView
    title={cat.name}
    description={cat.description}
    active={cat.key}
    categories={categories}
    subcategories={cat.subcategories}
    photos={wall}
    emptyMessage={`Nothing in ${cat.name} yet — add a folder under src/photos/ and rebuild.`}
  />
</Layout>
